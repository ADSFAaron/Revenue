/android/app/release

/android/key.properties
lib/firebase_options.dart
ios/Runner/GoogleService-Info.plist
google-services.json
android/app/google-services.json

# firebase.json is deliberately NOT ignored. The Firestore rules and indexes
# only deploy through its `firestore` block, and the hosting rewrites are the
# only thing making /.well-known/* reachable — none of which survived a fresh
# clone while the file was untracked. It holds a projectId and appIds, which
# are compiled into every client build anyway; the API key lives in
# lib/firebase_options.dart, which stays ignored.

# Firebase Hosting deploy cache
.firebase/

# Local-only notes, never published (security findings, private context)
*.local.md

# Agent skills fetched from upstream per skills-lock.json — the lock file is
# committed, the fetched content is not (same split as pubspec.lock/.dart_tool).
.agents/

# Demo-data seeding. Kept out of the public repo: these carry a default login
# for a store that lives on the real Firebase project, and they are operator
# tooling rather than part of the app.
tool/seed_demo.js
tool/demo_store.js
tool/.seed-backup.json

node_modules/
