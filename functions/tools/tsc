#!/bin/sh
# Runs the TypeScript compiler without going through `node`.
#
# TypeScript 7 is the Go port: `node_modules/typescript/bin/tsc` is a two-line
# ES module whose only job is to exec a native binary shipped in a per-platform
# package. Running that binary directly is the same compile with one fewer
# moving part — and the moving part it removes is the one that breaks.
#
# What breaks: the standalone (pkg-bundled) `firebase` CLI prepends its own
# Node 20 to PATH before running a predeploy hook, so the shim's
# `#!/usr/bin/env node` resolves to that Node rather than the developer's. It
# loads the shim's `.js` as CommonJS whatever the package's `"type": "module"`
# says, and the deploy dies with `Cannot use import statement outside a module`
# before a byte is uploaded — while `npm run build` in a terminal, with a real
# Node, is fine. Same family as the note in test/rules/package.json, and the
# same lesson: nothing in a Firebase hook may assume anything about the process
# it was started from.
#
# Which is also why the package is FOUND rather than named. Deriving it from
# `uname -m` looked obvious and was wrong for exactly the same reason: that
# firebase binary is x86_64, so under Rosetta every child of it reports x86_64
# on an arm64 Mac, and the derived path pointed at a package npm had never
# installed. Whatever is on disk is what npm resolved for this machine, so that
# is the thing to run. (Executing an arm64 binary from an x86_64 process is
# fine; macOS picks the right one.)
#
# Only the hook uses this. `npm run build` and `npm run lint` still call `tsc`
# the ordinary way, because they run under the developer's own Node, where the
# shim works.
set -e

dir="$(cd "$(dirname "$0")/.." && pwd)"

exe=""
for candidate in "$dir"/node_modules/@typescript/typescript-*/lib/tsc; do
  if [ -x "$candidate" ]; then
    exe="$candidate"
    break
  fi
done

if [ -n "$exe" ]; then
  exec "$exe" "$@"
fi

# Nothing on disk — an unsupported platform, or an install that skipped
# optional packages. The shim is correct wherever the ambient node can load an
# ES module, which is every Node this project supports.
echo "tools/tsc: no native compiler under $dir/node_modules/@typescript;" >&2
echo "tools/tsc: falling back to the node shim" >&2
exec "$dir/node_modules/.bin/tsc" "$@"
